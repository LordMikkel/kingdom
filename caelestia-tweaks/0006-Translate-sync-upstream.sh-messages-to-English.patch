From 1e30484c55bdd6bb3d160f66ac94277c9bc5844e Mon Sep 17 00:00:00 2001
From: LordMikkel <125906789+LordMikkel@users.noreply.github.com>
Date: Sun, 27 Sep 2026 17:56:15 +0200
Subject: [PATCH 6/8] Translate sync-upstream.sh messages to English

---
 sync-upstream.sh | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/sync-upstream.sh b/sync-upstream.sh
index 78d6cd2..9f818ec 100755
--- a/sync-upstream.sh
+++ b/sync-upstream.sh
@@ -8,7 +8,7 @@ REPO=$(cd "$(dirname "$0")" && pwd)
 cd "$REPO"
 
 if [[ -n $(git status --porcelain) ]]; then
-    echo "Hay cambios sin commitear. Haz commit o stash antes de sincronizar." >&2
+    echo "Uncommitted changes. Commit or stash them before syncing." >&2
     exit 1
 fi
 
@@ -20,17 +20,17 @@ git worktree add -q "$tmp" upstream
 rsync -a --delete --exclude .git "$SRC/" "$tmp/"
 git -C "$tmp" add -A
 if git -C "$tmp" diff --cached --quiet; then
-    echo "upstream ya está en $ver, nada que importar."
+    echo "upstream is already at $ver, nothing to import."
 else
     git -C "$tmp" commit -q -m "upstream: caelestia-shell $ver"
-    echo "Importado caelestia-shell $ver en la rama upstream."
+    echo "Imported caelestia-shell $ver into the upstream branch."
 fi
 
 git checkout -q main
 if git rebase upstream; then
-    echo "Tweaks reaplicados sobre $ver. Reinicia el shell para cargarlos."
+    echo "Tweaks reapplied on top of $ver. Restart the shell to load them."
 else
-    echo "Hay conflictos: resuélvelos, luego 'git add' + 'git rebase --continue'" >&2
-    echo "(o 'git rebase --abort' para volver al estado anterior)." >&2
+    echo "Conflicts found: resolve them, then 'git add' + 'git rebase --continue'" >&2
+    echo "(or 'git rebase --abort' to go back to the previous state)." >&2
     exit 1
 fi
