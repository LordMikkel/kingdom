[a11y]
always-show-universal-access-status=false

[a11y/applications]
screen-magnifier-enabled=false

[a11y/interface]
high-contrast=false
show-status-shapes=false

[a11y/keyboard]
togglekeys-enable=false

[a11y/magnifier]
