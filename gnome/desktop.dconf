[applications/terminal]
exec='ghostty'
exec-arg='-e'

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/gnome/amber-l.jxl'
picture-uri-dark='file:///usr/share/backgrounds/gnome/amber-d.jxl'
primary-color='#ff7800'
secondary-color='#000000'

[break-reminders]
selected-breaks=@as []

[break-reminders/eyesight]
play-sound=false

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=false

[calendar]
show-weekdate=false

[input-sources]
mru-sources=[('xkb', 'us'), ('xkb', 'es')]
sources=[('xkb', 'us'), ('xkb', 'es')]
xkb-options=['terminate:ctrl_alt_bksp']

[interface]
accent-color='blue'
clock-format='24h'
clock-show-seconds=false
clock-show-weekday=false
color-scheme='prefer-dark'
cursor-theme='Adwaita'
gtk-enable-primary-paste=false
icon-theme='Adwaita'
overlay-scrolling=true
show-battery-percentage=true
toolkit-accessibility=false

[media-handling]
autorun-never=true

[notifications]
application-children=['vivaldi-stable', 'org-gnome-software', 'org-gnome-console', 'protonvpn', 'gnome-power-panel', 'gnome-about-panel', 'org-gnome-texteditor', 'code', 'gnome-wellbeing-panel', 'org-gnome-nautilus', 'torbrowser', 'signal-desktop', 'session-desktop', 'org-gnome-characters', 'org-gnome-showtime', 'com-brave-browser', 'network-loki-session', 'com-vivaldi-vivaldi', 'opensnitch-ui', 'org-gnome-extensions', 'org-localsend-localsend-app', 'org-gnome-settings', 'org-gnome-decibels', 'org-qbittorrent-qbittorrent', 'com-usebottles-bottles', 'dev-zed-zed', 'org-libreoffice-libreoffice-writer', 'org-upscayl-upscayl', 'org-libreoffice-libreoffice', 'com-mitchellh-ghostty', 'fm-reaper-reaper', 'cockos-reaper', 'org-gnome-builder', 'app-zen-browser-zen', 'com-anthropic-claudecode']
