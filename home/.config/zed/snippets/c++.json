{
  "Orthodox Canonical Form (header)": {
    "prefix": "ocf-hpp",
    "description": "OCF class declaration (C++98)",
    "body": [
      "#ifndef ${1:CLASS_NAME}_HPP",
      "# define ${1:CLASS_NAME}_HPP",
      "",
      "# include \"../../../lib/libft/inc/libft.hpp\"",
      "",
      "class ${1:ClassName}",
      "{",
      "\tprivate:",
      "\t\t",
      "",
      "\tpublic:",
      "\t\t// Live & Death",
      "\t\t${1:ClassName}(void);",
      "\t\t${1:ClassName}(const ${1:ClassName} &original);",
      "\t\t${1:ClassName} &operator=(const ${1:ClassName} &original);",
      "\t\t~${1:ClassName}(void);",
      "",
      "\t\t//Getters and Setters",
      "",
      "",
      "\t\t//Functions",
      "",
      "",
      "\t\t//Exeptions",
      "",
      "",
      "};",
      "",
      "#endif",
      "$0"
    ]
  },
  "Orthodox Canonical Form (cpp)": {
    "prefix": "ocf-cpp",
    "description": "OCF method definitions (C++98)",
    "body": [
      "#include \"${1:ClassName}.hpp\"",
      "",
      "/* ************************************************************************** */",
      "/*                              Live and Death                                */",
      "/* ************************************************************************** */",
      "",
      "${1:ClassName}::${1:ClassName}(void)",
      "{",
      "}",
      "",
      "${1:ClassName}::${1:ClassName}(const ${1:ClassName} &original)",
      "{",
      "\t*this = original;",
      "}",
      "",
      "${1:ClassName} &${1:ClassName}::operator=(const ${1:ClassName} &original)",
      "{",
      "\tif (this != &original)",
      "\t{",
      "\t\t${2}",
      "\t}",
      "\treturn ( *this );",
      "}",
      "",
      "${1:ClassName}::~${1:ClassName}(void)",
      "{",
      "}",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                               Operators                                    */",
      "/* ************************************************************************** */",
      "",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                               Exceptions                                   */",
      "/* ************************************************************************** */",
      "",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                           Getters & Setters                                */",
      "/* ************************************************************************** */",
      "",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                                Helpers                                     */",
      "/* ************************************************************************** */",
      "",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                           Private Functions                                */",
      "/* ************************************************************************** */",
      "",
      "",
      "",
      "/* ************************************************************************** */",
      "/*                           Public Functions                                 */",
      "/* ************************************************************************** */",
      "$0"
    ]
  }
}
